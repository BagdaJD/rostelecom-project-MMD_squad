# Переменные сборки фронтенда (Vite). Скопировать в frontend/.env.local — он в .gitignore.
# Секретов здесь быть не должно: значения попадают в бандл.

# Адрес API. По умолчанию клиент ходит на относительный /api/v1, и это правильный режим:
# в dev путь догоняет прокси из vite.config.ts, в проде — location /api/ в nginx.
# Задавать полный URL нужно только если API живёт на другом домене.
# VITE_API_URL=https://api.example.com/api/v1

# Куда dev-прокси отправляет /api. По умолчанию http://localhost:8000.
# VITE_API_PROXY_TARGET=http://localhost:8000

# '1' — работать на моках вместо бэкенда (только dev). Сценарии: ?mock=1&scenario=empty|error
# VITE_USE_MOCKS=1

# Источник тайлов для MapLibre. Без него карта рисует только агрегаты по регионам.
# VITE_MAP_STYLE_URL=https://example.com/style.json
