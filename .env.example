# --- Приложение ---
APP_ENV=dev
SECRET_KEY=change-me-to-a-64-char-random-string
TOTP_ENCRYPTION_KEY=change-me-32-byte-urlsafe-key
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
DEFAULT_PASSWORD=change-me-in-production

# --- База данных ---
POSTGRES_USER=rtk
POSTGRES_PASSWORD=rtk
POSTGRES_DB=rtk
DATABASE_URL=postgresql+psycopg://rtk:rtk@postgres:5432/rtk

# --- Очередь ---
REDIS_URL=redis://redis:6379/0

# --- Фронтенд ---
VITE_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173
# Источник тайлов карты. Публичные тайловые сервисы в демо не используются без
# проверки условий использования: без переменной рисуется только слой агрегатов.
VITE_MAP_STYLE_URL=

# --- Загрузка источников (адаптеры отключены, пока не согласованы условия использования) ---
INGEST_ENABLED=false
INGEST_CRON=*/30 * * * *
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW_SEC=900
